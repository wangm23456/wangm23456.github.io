{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "topic": {
      "type": "string",
      "enum": [
        "muscle",
        "alcohol",
        "weight-loss-drugs",
        "fitness-supplements"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "topic"
  ]
}