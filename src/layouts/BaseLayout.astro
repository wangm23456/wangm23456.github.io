---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { text: '首页', href: '/' },
  { text: '博客文章', href: '/blog/' },
  { text: 'research', href: '/research/' },
  { text: 'Space Now', href: '/space-now/' },
  { text: '关于', href: '/about/' },
];
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Arcana</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" type="image/png" href="/favicon-32.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon-180.png?v=2" />
    <link rel="alternate" type="application/rss+xml" title="Arcana" href="/rss.xml" />
    <script is:inline>
      // 防闪烁：渲染前恢复暗色偏好
      const saved = localStorage.getItem('theme');
      if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-title" href="/" aria-label="Arcana 首页">
          <Logo size={32} />
          <span class="site-title__desc">Engineering Is Magic</span>
        </a>
        <nav class="site-nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={path === item.href || (item.href !== '/' && path.startsWith(item.href)) ? 'page' : undefined}>
              {item.text}
            </a>
          ))}
          <button class="dark-toggle" id="dark-toggle" type="button">◐</button>
        </nav>
      </div>
    </header>

    <main class={wide ? 'container container--wide' : 'container'}>
      <slot />
    </main>

    <footer class="site-footer">
      Powered by <a href="https://astro.build">Astro</a> · Arcana © 2026 ·
      <a href="/rss.xml">RSS</a>
    </footer>

    <script is:inline>
      document.getElementById('dark-toggle').addEventListener('click', () => {
        const el = document.documentElement;
        el.classList.toggle('dark');
        localStorage.setItem('theme', el.classList.contains('dark') ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
