---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  home?: boolean;
}

const { title, description, wide = false, home = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const nav = [
  { text: '首页', href: '/' },
  { text: '文章', href: '/blog/' },
  { text: '研究', href: '/research/' },
  { text: '太空观测', href: '/space-now/' },
  { text: '关于', href: '/about/' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Arcana</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" type="image/png" href="/favicon-32.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon-180.png?v=2" />
    <link rel="alternate" type="application/rss+xml" title="Arcana" href="/rss.xml" />
    <script is:inline>
      {
        let saved;
        try { saved = localStorage.getItem('theme'); } catch {}
        if (saved === 'dark' || (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      }
    </script>
  </head>
  <body class:list={[{ 'is-home': home }]}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header arcana-header">
      <div class="site-header__inner">
        <a class="site-title" href="/" aria-label="Arcana 首页">
          <Logo size={30} />
          <span class="wordmark">ARCANA</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((item) => {
            const href = item.href.replace(/\/$/, '') || '/';
            const active = path === href || (href !== '/' && path.startsWith(`${href}/`));
            return <a href={item.href} aria-current={active ? 'page' : undefined}>{item.text}</a>;
          })}
        </nav>
        <button class="dark-toggle" id="dark-toggle" type="button" aria-label="深色模式" hidden>
          <span aria-hidden="true">◐</span>
        </button>
      </div>
    </header>

    <main id="main-content" class:list={['container', { 'container--wide': wide, 'container--home': home }]}>
      <slot />
    </main>

    <footer class="site-footer arcana-footer">
      <div class="footer-inner">
        <span><strong>Arcana</strong> · 潘勒斯的个人站</span>
        <div><a href="/about/">关于</a><a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a></div>
      </div>
    </footer>

    <script is:inline>
      {
        const toggle = document.getElementById('dark-toggle');
        const root = document.documentElement;
        const reflect = () => toggle.setAttribute('aria-pressed', String(root.classList.contains('dark')));
        reflect();
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const dark = root.classList.toggle('dark');
          reflect();
          try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
        });
      }
    </script>
  </body>
</html>

<style>
  .is-home { --paper: #f8f5ef; --card: #fffdf8; --ink: #201b21; --muted: #5f555f; background-image: none; }
  :global(html.dark) .is-home { --paper: #19151b; --card: #241f27; --ink: #faf2f8; --muted: #c2b4c0; }
  .skip-link { position: fixed; z-index: 50; top: 0.5rem; left: 0.5rem; transform: translateY(-150%); padding: 0.5rem 0.8rem; background: var(--ink); color: var(--paper); }
  .skip-link:focus { transform: none; }
  .arcana-header { border-bottom: 1px solid color-mix(in srgb, var(--ink) 23%, transparent); }
  .site-header__inner { max-width: 76rem; display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.6rem 1rem; padding: 0.65rem clamp(1rem, 3vw, 2rem); min-height: 4rem; }
  .site-title { justify-self: start; color: var(--ink); }
  .wordmark { font-weight: 900; font-size: 1.05rem; letter-spacing: 0.09em; line-height: 1; }
  .site-nav { gap: 0.3rem; }
  .arcana-header .site-nav a { padding: 0.45rem 0.65rem; border: 0; background: transparent; box-shadow: none; border-radius: 0.25rem; }
  .arcana-header .site-nav a:hover { background: var(--card); transform: none; }
  .arcana-header .site-nav a[aria-current='page'] { color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.37em; }
  .arcana-header .dark-toggle { justify-self: end; width: 2.3rem; height: 2.3rem; padding: 0; border: 1px solid color-mix(in srgb, var(--ink) 30%, transparent); border-radius: 50%; background: transparent; font-size: 1.05rem; box-shadow: none; }
  .arcana-header .dark-toggle:hover { background: var(--card); transform: none; }
  .container--home { max-width: 76rem; padding: clamp(1.6rem, 4vw, 3.25rem) clamp(1rem, 3vw, 2rem) 4rem; }
  .arcana-footer { border-top: 1px solid color-mix(in srgb, var(--ink) 23%, transparent); background: var(--paper); color: var(--muted); padding: 0; text-align: left; }
  .footer-inner { max-width: 76rem; margin: auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.6rem 1rem; padding: 1.1rem clamp(1rem, 3vw, 2rem); }
  .footer-inner div { display: flex; gap: 1rem; }
  .arcana-footer a { color: var(--ink); text-underline-offset: 0.2em; }
  @media (max-width: 625px) {
    .site-header__inner { grid-template-columns: 1fr auto; gap: 0.2rem 0.6rem; padding-bottom: 0.35rem; }
    .site-nav { grid-column: 1 / -1; grid-row: 2; margin-inline: -0.55rem; }
    .arcana-header .site-nav a { padding-inline: 0.55rem; }
    .arcana-header .dark-toggle { grid-column: 2; grid-row: 1; }
  }
</style>
