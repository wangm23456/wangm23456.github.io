      "row": 2,
      "tag": "MAE 21.88"
    }
  ],
  "flows": [
    {
      "id": "cgm-to-state",
      "from": "cgm-input",
      "to": "state-stream",
      "label": "因果滤波平滑",
      "classification": "慢变趋势",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "cgm-to-event",
      "from": "cgm-input",
      "to": "event-stream",
      "label": "残差差分计算",
      "classification": "快变脉冲",
      "variant": "default"
    },
    {
      "id": "mask-to-filter",
      "from": "obs-mask",
      "to": "state-stream",
      "label": "掩码感知加权",
      "classification": "防插值污染",
      "variant": "security"
    },
    {
      "id": "mask-to-event",
      "from": "obs-mask",
      "to": "event-stream",
      "label": "缺失项置零",
      "classification": "有效残差",
      "variant": "security",
      "route": "straight"
    },
    {
      "id": "state-to-patch",
      "from": "state-stream",
      "to": "patch-fusion",
      "label": "64维 State Token",
      "classification": "基线特征",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "event-to-patch",
      "from": "event-stream",
      "to": "patch-fusion",
      "label": "64维 Event Token",
      "classification": "事件特征",
      "variant": "default"
    },
    {
      "id": "time-to-patch",
      "from": "time-enc",
      "to": "patch-fusion",
      "label": "圆形时刻注入",
      "classification": "相位特征",
      "variant": "dashed"
    },
    {
      "id": "patch-to-context",
      "from": "patch-fusion",
      "to": "context-encoder",
      "label": "可见上下文采样",
      "classification": "随机掩码",
      "variant": "emphasis"
    },
    {
      "id": "patch-to-target",
      "from": "patch-fusion",
      "to": "target-encoder",
      "label": "完整生理序列",
      "classification": "无掩码输入",
      "variant": "default"
    },
    {
      "id": "context-to-pred",
      "from": "context-encoder",
      "to": "predictor",
      "label": "上下文潜表征",
      "classification": "潜空间预测",
      "variant": "emphasis"
    },
    {
      "id": "pred-to-mcr",
      "from": "predictor",
      "to": "mcr-loss",
      "label": "预测目标潜变量",
      "classification": "表征空间对齐",
      "variant": "security"
    },
    {
      "id": "target-to-mcr",
      "from": "target-encoder",
      "to": "mcr-loss",
      "label": "EMA 潜变量目标",
      "classification": "梯度截断",
      "variant": "default"
    },
    {
      "id": "target-to-td",
      "from": "target-encoder",
      "to": "td-loss",
      "label": "下一步状态目标",
      "classification": "残差转移",
      "variant": "default",
      "route": "straight"
    },
    {
      "id": "patch-to-probes",
      "from": "patch-fusion",
      "to": "linear-probes",
      "label": "冻结日级 Embedding",
      "classification": "少样本表型",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "patch-to-ppgr",
      "from": "patch-fusion",
      "to": "ppgr-forecast",
      "label": "餐前 24h/1h 上下文",
      "classification": "两小时轨迹",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "生理时钟双流解耦",
      "items": [
        "通过可学习因果高斯核（带宽 10-60 min）剥离慢变稳态基线",
        "快变 Event 流专职捕捉餐后糖负荷与急性应激脉冲",
        "彻底解决单一时间尺度模型对高频噪声与基线漂移混淆的问题"
      ]
    },
    {
      "dot": "rose",
      "title": "非生成式 JEPA 潜变量学习",
      "items": [
        "不在观测空间做带有传感器压缩伪影与插值误差的数值重建",
        "在抽象表征流形上通过 Predictor 预测被掩码 Patch 的 EMA 潜变量",
        "观测加权损失使严重缺失的 Patch 不干扰整体模型优化"
      ]
    },
    {
      "dot": "orange",
      "title": "0.72M 极简表征的高效迁移",
      "items": [
        "3 层 Transformer 即可支撑 14 类异构代谢表型探针（PR-AUC 58.8）",
        "在 CGMacros 双传感器基准上实现 21.88 mg/dL 的两小时餐后轨迹 MAE",
        "轻量级架构为智能手表、手环与端侧边缘代谢监测铺平工程道路"
      ]
    }
  ]
}
