{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "GlucoFM 双流因果滤波与 JEPA 潜变量预训练数据流",
    "locale": "zh-CN",
    "output": "website/public/diagrams/glucofm-dataflow.html",
    "viewBox": [1120, 780],
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "dual-stream-split",
        "label": "因果双流解耦",
        "focus": ["cgm-input", "obs-mask", "state-stream", "event-stream", "patch-fusion"],
        "note": "将 24 小时原始读数通过因果高斯滤波解耦为慢变基线与高频残差脉冲。"
      },
      {
        "id": "jepa-latent-alignment",
        "label": "JEPA 掩码潜变量对齐",
        "focus": ["context-encoder", "target-encoder", "predictor", "mcr-loss", "td-loss"],
        "note": "在线上下文 Encoder 预测 EMA 目标在表征流形上的潜变量，避免像素级过拟合。"
      },
      {
        "id": "downstream-transfer",
        "label": "冻结表征与下游任务",
        "focus": ["patch-fusion", "linear-probes", "ppgr-forecast"],
        "note": "冻结 Encoder 提取通用生理 Embedding，支持 14 个代谢表型探针与两小时 PPGR 预测。"
      }
    ]
  },
  "stages": [
    { "label": "采样与对齐" },
    { "label": "因果解耦" },
    { "label": "Patch 融合" },
    { "label": "JEPA 潜变量" },
    { "label": "下游迁移" }
  ],
  "nodes": [
    {
      "id": "cgm-input",
      "type": "frontend",
      "label": "24h CGM 时序",
      "sublabel": "288 步 / 5min 采样",
      "stage": 0,
      "row": 0,
      "tag": "生理时序"
    },
    {
      "id": "obs-mask",
      "type": "security",
      "label": "观测掩码 M",
      "sublabel": "显式标记物理缺失",
      "stage": 0,
      "row": 2,
      "tag": "真实事实"
    },
    {
      "id": "time-enc",
      "type": "cloud",
      "label": "昼夜时刻编码",
      "sublabel": "正弦/余弦圆形相位",
      "stage": 0,
      "row": 4,
      "tag": "24h 周期"
    },
    {
      "id": "state-stream",
      "type": "backend",
      "label": "慢变 State 流",
      "sublabel": "因果高斯滤波平滑",
      "stage": 1,
      "row": 0,
      "tag": "稳态基线"
    },
    {
      "id": "event-stream",
      "type": "messagebus",
      "label": "快变 Event 流",
      "sublabel": "观测残差与变化率",
      "stage": 1,
      "row": 2,
      "tag": "急性脉冲"
    },
    {
      "id": "patch-fusion",
      "type": "backend",
      "label": "24h Patch 融合",
      "sublabel": "128 维生理 Token",
      "stage": 2,
      "row": 0,
      "tag": "逐时表征"
    },
    {
      "id": "context-encoder",
      "type": "backend",
      "label": "Context Encoder",
      "sublabel": "随机掩码 50%~60%",
