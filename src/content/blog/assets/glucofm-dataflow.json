      "row": 2,
      "tag": "在线分支"
    },
    {
      "id": "target-encoder",
      "type": "database",
      "label": "Target Encoder",
      "sublabel": "完整序列 EMA 编码",
      "stage": 2,
      "row": 4,
      "tag": "目标分支"
    },
    {
