---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpaceLaunchWidget from '../components/space/SpaceLaunchWidget';
---

<BaseLayout title="Space Now" description="Launch Library 2 发射任务实时观测" wide>
  <div class="space-now container">
    <SpaceLaunchWidget variant="full" client:load />
  </div>
</BaseLayout>

<style>
  /* Hallmark · shape: Workbench · genre: playful · theme: Hum (deal 2/3, seed zompopo-7e95·8fca6596·2026-11-24·r0) · redesign: full
   * hero: Pinned (/space-now) · nav: chip rail · footer: mast + colophon · imagery: none · signature: card-stock launch card
   * sections: launch Pinned · manifest Rows · source colophon · axes: light/rounded-sans/chromatic-yellow · posture: Pinned */
  /* Hallmark · waivers: 44c/79 lint identifies only the intro as hero; the pinned launch card fills the remainder of the first screen · 77 dashboard has the existing manifest and source rather than invented sections · F19 shared navigation and widget weights are outside page scope · existing widget copy retains uppercase labels and middle dots to preserve all copy and wiring. */
  .space-now { padding-top: var(--space-xl); padding-bottom: var(--section-gap); }
  .space-now :global(.space-page) { max-width: 100%; color: var(--color-ink); }
  .space-now :global(.space-intro) { display: flex; align-items: end; justify-content: space-between; gap: var(--space-lg); margin: 0 0 var(--space-xl); }
  .space-now :global(.space-intro h1) { font-size: var(--text-display); line-height: 1; }
  .space-now :global(.space-intro h1 em) { color: inherit; font-style: normal; }
  .space-now :global(.space-kicker), .space-now :global(.space-card-head), .space-now :global(.space-feed-status__label), .space-now :global(.space-label), .space-now :global(.space-metadata dt), .space-now :global(.space-countdown > span), .space-now :global(.space-section-count), .space-now :global(.space-source) { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 600; letter-spacing: normal; line-height: 1.5; color: var(--color-ink-2); }
  .space-now :global(.space-kicker) { margin: 0 0 var(--space-xs); }
  .space-now :global(.space-feed-status) { min-width: min(100%, 18rem); padding: var(--space-md); border: 1px solid var(--color-edge); border-radius: var(--radius-stock); background: var(--color-paper-2); color: var(--color-ink); box-shadow: none; }
  .space-now :global(.space-feed-status strong) { display: block; margin: var(--space-3xs) 0; font: 600 var(--text-md)/1.4 var(--font-body); color: var(--color-ink); }
  .space-now :global(.space-feed-status strong::before), .space-now :global(.space-live-mark i) { display: none; }
  .space-now :global(.space-feed-status time) { display: block; color: var(--color-ink-2); font: var(--text-xs)/1.5 var(--font-mono, var(--font-outlier)); }
  .space-now :global(.space-feed-status button) { min-height: 44px; width: 100%; margin-top: var(--space-sm); padding: var(--space-xs) var(--space-md); border: 1px solid var(--color-edge); border-radius: var(--radius-stock); background: var(--color-card); color: var(--color-ink); font: 600 var(--text-xs)/1.4 var(--font-body); letter-spacing: normal; cursor: pointer; transition: transform var(--dur-micro) var(--ease-spring); }
  .space-now :global(.space-feed-status button:hover) { background: var(--color-paper-3); color: var(--color-ink); }
  .space-now :global(.space-feed-status button:active) { transform: translateY(2px); }
  .space-now :global(.space-feed-status button:disabled) { opacity: 0.75; cursor: wait; }
  .space-now :global(.space-command-grid) { display: block; }
  .space-now :global(.space-primary-card) { overflow: hidden; border: 1px solid var(--color-edge); border-radius: var(--radius-card); background: var(--color-card); color: var(--color-ink); box-shadow: var(--shadow-card); }
  .space-now :global(.space-card-head) { display: flex; justify-content: space-between; gap: var(--space-md); padding: var(--space-md) var(--space-xl); border-bottom: 1px solid var(--color-edge); background: var(--color-paper-2); }
  .space-now :global(.space-live-mark) { color: var(--color-ink); }
  .space-now :global(.space-primary-layout) { display: block; padding: var(--space-xl); }
  .space-now :global(.space-primary-copy) { min-width: 0; }
  .space-now :global(.space-label) { margin: 0 0 var(--space-xs); }
  .space-now :global(.space-primary-copy h2) { max-width: 25ch; margin: 0; color: var(--color-ink); font-size: var(--text-section); line-height: 1.12; text-wrap: balance; }
  .space-now :global(.space-provider) { min-height: 0; margin: var(--space-sm) 0 0; color: var(--color-ink-2); font-size: var(--text-md); }
  .space-now :global(.space-metadata) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-lg); margin: var(--space-xl) 0; }
  .space-now :global(.space-metadata > div) { min-width: 0; padding-top: var(--space-sm); border-top: 1px solid var(--color-rule); }
  .space-now :global(.space-metadata dd) { margin: var(--space-xs) 0 0; color: var(--color-ink); font-size: var(--text-md); overflow-wrap: anywhere; }
  .space-now :global(.space-metadata > div:first-child dd) { font-family: var(--font-mono, var(--font-outlier)); font-size: var(--text-sm); }
  .space-now :global(.space-countdown) { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-xs) var(--space-lg); padding: var(--space-lg); border: 1px solid var(--color-edge); border-radius: var(--radius-stock); background: var(--color-paper-2); color: var(--color-ink); }
  .space-now :global(.space-countdown strong) { color: var(--color-ink); font: 600 clamp(1.5rem, 4vw, 3rem)/1.2 var(--font-mono, var(--font-outlier)); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .space-now :global(.space-countdown small) { flex-basis: 100%; color: var(--color-ink-2); font-size: var(--text-xs); }
  .space-now :global(.space-upcoming-section) { margin-top: var(--section-gap-s); }
  .space-now :global(.space-section-head) { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-md); margin-bottom: var(--space-lg); }
  .space-now :global(.space-section-head h2) { margin: 0; color: var(--color-ink); font-size: var(--text-section); }
  .space-now :global(.space-launch-list) { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-rule); }
  .space-now :global(.space-launch-item) { display: grid; grid-template-columns: 3rem minmax(0, 1fr) minmax(9rem, auto); gap: var(--space-lg); padding: var(--space-lg) 0; border-bottom: 1px solid var(--color-rule); color: var(--color-ink); }
  .space-now :global(.space-launch-index), .space-now :global(.space-launch-time time) { color: var(--color-ink-2); font: var(--text-sm)/1.5 var(--font-mono, var(--font-outlier)); }
  .space-now :global(.space-launch-main) { min-width: 0; }
  .space-now :global(.space-launch-main strong) { color: var(--color-ink); font-size: var(--text-lg); }
  .space-now :global(.space-launch-main span), .space-now :global(.space-launch-main p) { display: block; margin: var(--space-xs) 0 0; color: var(--color-ink-2); font-size: var(--text-md); line-height: 1.55; text-wrap: pretty; }
  .space-now :global(.space-launch-time) { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-xs); }
  .space-now :global(.space-launch-time span) { color: var(--color-ink-2); font-size: var(--text-xs); }
  .space-now :global(.space-empty) { display: flex; flex-direction: column; gap: var(--space-xs); padding: var(--space-lg) 0; color: var(--color-ink-2); font-size: var(--text-md); border-bottom: 1px solid var(--color-rule); }
  .space-now :global(.space-source) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-md); margin-top: var(--space-xl); padding-top: var(--space-md); border-top: 1px solid var(--color-rule); }
  .space-now :global(:is(a, button):focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .space-now :global(*), .space-now :global(*::before), .space-now :global(*::after) { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
  }
  @media (max-width: 40rem) {
    .space-now :global(.space-intro) { align-items: stretch; flex-direction: column; }
    .space-now :global(.space-card-head) { padding: var(--space-md) var(--space-lg); }
    .space-now :global(.space-primary-layout) { padding: var(--space-lg); }
    .space-now :global(.space-metadata) { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); }
    .space-now :global(.space-launch-item) { grid-template-columns: 2rem minmax(0, 1fr); gap: var(--space-sm); }
    .space-now :global(.space-launch-time) { grid-column: 2; }
  }
</style>
