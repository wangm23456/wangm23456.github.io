---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('research');
  return notes.map((note) => ({
    params: { slug: note.id.replace(/\.md$/, '') },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const notes = await getCollection('research');
const orderedNotes = notes.sort((a, b) => a.id.localeCompare(b.id, 'en'));
const currentIndex = orderedNotes.findIndex((item) => item.id === note.id);
const previous = orderedNotes[currentIndex - 1];
const next = orderedNotes[currentIndex + 1];
---

<BaseLayout title={`${note.data.title} · 原始研究资料`} description={note.data.description}>
  <article class="prose research-document">
    <nav class="research-breadcrumb" aria-label="页面路径">
      <a href="/research/">原始研究资料</a>
      <span aria-hidden="true">/</span>
      <span>{note.data.title}</span>
    </nav>
    <header class="research-header">
      <p class="research-label">RESEARCH MATERIAL / {String(currentIndex + 1).padStart(2, '0')}</p>
      <p class="research-title">{note.data.title}</p>
      <p>{note.data.description}</p>
    </header>
    <div class="research-content"><Content /></div>
    <nav class="research-pagination" aria-label="研究资料导航">
      {previous ? <a href={`/research/${previous.id.replace(/\.md$/, '')}/`}>{previous.data.title}</a> : <span />}
      {next ? <a href={`/research/${next.id.replace(/\.md$/, '')}/`}>{next.data.title}</a> : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  /* Hallmark · shape: Long Document · genre: playful · theme: Hum (deal 2/3, seed zompopo-7e95·8fca6596·2026-11-24·r0) · redesign: full
   * hero: Rows (read) · nav: breadcrumb · footer: adjacent notes · imagery: article content · signature: card-stock wells
   * sections: reading header + prose + navigation · axes: light/rounded-sans/chromatic-yellow · posture: Rows-read · copy: verbatim */
  /* Hallmark · waivers: 26b no form controls on page · 79 reading template starts prose directly below its header; the fold heuristic treats article content as empty · 77 long-form reading is a single continuous section */
  .research-document { width: min(100% - 2 * var(--gutter), 70ch); margin-inline: auto; padding-block: var(--space-xl) var(--space-3xl); }
  .research-breadcrumb { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-bottom: var(--space-xl); color: var(--color-ink-2); font-size: var(--text-sm); }
  .research-breadcrumb a, .research-content :global(a) { color: var(--color-ink); text-decoration-color: var(--color-accent-2); text-underline-offset: 0.2em; }
  .research-breadcrumb a { display: inline-flex; align-items: center; min-height: 44px; }
  .research-header { padding-bottom: var(--space-xl); margin-bottom: var(--space-xl); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .research-label { margin-bottom: var(--space-md); color: var(--color-ink-2); font-size: var(--text-sm); text-transform: lowercase; }
  .research-title { max-width: 20ch; margin: 0 0 var(--space-md); font-family: var(--font-display); font-size: var(--text-display-s); font-weight: var(--display-weight, 700); font-synthesis: none; line-height: 1.05; letter-spacing: var(--tracking-display); overflow-wrap: break-word; min-width: 0; text-wrap: balance; }
  .research-header p:last-child { color: var(--color-ink-2); font-size: var(--text-lead); line-height: 1.65; text-wrap: pretty; }
  .research-content { min-width: 0; font-size: var(--text-md); line-height: 1.8; overflow-wrap: anywhere; }
  .research-content :global(h1), .research-content :global(h2) { margin: var(--space-2xl) 0 var(--space-lg); font-family: var(--font-display); font-size: var(--text-section); text-wrap: balance; }
  .research-content :global(h3) { margin: var(--space-xl) 0 var(--space-md); font-family: var(--font-display); font-size: var(--text-title); text-wrap: balance; }
  .research-content :global(p) { margin: 0 0 var(--space-lg); text-wrap: pretty; }
  .research-content :global(ul), .research-content :global(ol) { padding-left: 1.5em; margin: 0 0 var(--space-lg); }
  .research-content :global(li + li) { margin-top: var(--space-xs); }
  .research-content :global(blockquote) { margin: var(--space-xl) 0; padding: var(--space-lg); border: var(--rule-hair) solid var(--color-edge); border-radius: var(--radius-stock); background: var(--color-paper-2); color: var(--color-ink); }
  .research-content :global(blockquote > :last-child) { margin-bottom: 0; }
  .research-content :global(code) { font-family: var(--font-mono, var(--font-outlier)); background: var(--color-paper-2); border-radius: var(--space-2xs); padding: 0.1em 0.25em; }
  .research-content :global(pre) { max-width: 100%; overflow-x: auto; padding: var(--space-lg); border: var(--rule-hair) solid var(--color-edge); border-radius: var(--radius-stock); background: var(--color-paper-2) !important; color: var(--color-ink); }
  .research-content :global(pre code) { padding: 0; background: transparent; }
  .research-content :global(table) { display: block; max-width: 100%; overflow-x: auto; margin: var(--space-xl) 0; border: var(--rule-hair) solid var(--color-edge); border-radius: var(--radius-stock); border-spacing: 0; background: var(--color-card); }
  .research-content :global(th), .research-content :global(td) { padding: var(--space-sm) var(--space-md); border-bottom: var(--rule-hair) solid var(--color-rule); text-align: left; vertical-align: top; }
  .research-content :global(th) { background: var(--color-paper-2); font-size: var(--text-sm); }
  .research-content :global(figure) { margin: var(--space-xl) 0; padding: var(--space-md); border: var(--rule-hair) solid var(--color-edge); border-radius: var(--radius-stock); background: var(--color-card); }
  .research-content :global(figcaption) { margin-top: var(--space-sm); color: var(--color-ink-2); font-size: var(--text-sm); }
  .research-pagination { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); margin-top: var(--space-2xl); padding-top: var(--space-lg); border-top: var(--rule-hair) solid var(--color-rule); }
  .research-pagination a { display: flex; align-items: center; min-height: 44px; color: var(--color-ink); text-decoration-color: var(--color-accent-2); text-underline-offset: 0.2em; }
  .research-document :is(a, button):focus-visible, .research-content :global(a:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .research-document *, .research-document *::before, .research-document *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
  }
  @media (max-width: 40rem) { .research-document { padding-top: var(--space-lg); } .research-pagination { grid-template-columns: minmax(0, 1fr); } .research-pagination span:empty { display: none; } }
</style>
