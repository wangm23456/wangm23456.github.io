---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsList from '../components/NewsList';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const [featured, ...recent] = posts.slice(0, 4);
const formatDate = (date: Date) => date.toISOString().slice(0, 10);

const destinations = [
  { title: '写作', description: '关于 AI、工程与科学的原创长文。', href: '/blog/', scene: 'writing', alt: '波波在书桌前写笔记' },
  { title: '研究笔记', description: '专题文章背后的文献与证据。', href: '/research/', scene: 'research', alt: '波波在实验台前观察烧瓶' },
  { title: '太空观测', description: '查看下一次火箭发射与任务动态。', href: '/space-now/', scene: 'space', alt: '波波在小火箭与星球旁拿着旗子' },
];
---

<BaseLayout title="潘勒斯的个人主页" description="潘勒斯的个人主页。和波波一起记录 AI、工程与科学，阅读原创长文、研究笔记和太空观测。" tone="lab">
  <div class="home">
    <section class="hero grain" data-bay aria-labelledby="hero-title">
      <div class="bay-wall" aria-hidden="true"></div>
      <div class="bay-floor" aria-hidden="true"></div>
      <div class="container bay-hud">
        <span class="stage-id">波波<span lang="en">ZOMPOPO / Unit 01</span></span>
        <button class="mascot-toggle" type="button" data-mascot-toggle hidden>暂停动画</button>
      </div>
      <div class="container hero-inner">
        <div class="hero-copy">
        <h1 id="hero-title"><span class="hero-kicker" lang="en" aria-hidden="true">Arcana / personal index</span>工程是魔法，<br />身体是圣殿<span class="dot">。</span>
          <span class="hero-sub" lang="en">Engineering is magic, the body is a temple.</span></h1>
        <p class="intro lead">我在这里记录 AI、工程与科学。读论文、拆系统，把好奇的问题写成文章。</p>
        <div class="actions">
          <a class="btn btn-primary" href="#writing">读最新文章</a>
          <a class="btn btn-ghost" href="/about/">关于我</a>
        </div>
      </div>
      </div>

      <figure class="mascot" data-mascot>
        <div class="mascot-frame">
          <span class="mascot-pool" aria-hidden="true"></span>
          <span class="mascot-shadow" aria-hidden="true"></span>
          <img class="mascot-img" src="/zompopo/idle.webp" alt="波波站着，手里拿着紫色哑铃和绿色小玩偶" width="640" height="1149" fetchpriority="high" />
          <div class="mascot-player" data-mascot-player></div>
        </div>
      </figure>
    </section>

    <div class="paper torn-top">
      <section class="home-sec container" id="writing" aria-labelledby="writing-title">
        <header class="sec-head">
          <h2 id="writing-title">最近写了什么</h2>
          <a class="btn btn-ghost" href="/blog/">所有文章</a>
        </header>
        {featured ? (
          <div class="writing-grid">
            <a class="featured" href={`/blog/${featured.id}/`}>
              <p class="card-label">最新一篇 · <time datetime={formatDate(featured.data.date)}>{formatDate(featured.data.date)}</time></p>
              <h3>{featured.data.title}</h3>
              {featured.data.description && <p class="featured-desc">{featured.data.description}</p>}
              <ul class="tag-row" aria-label="文章标签">
                {featured.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
              </ul>
            </a>
            {recent.length > 0 && (
              <ul class="recent-list">
                {recent.map((post) => (
                  <li>
                    <a href={`/blog/${post.id}/`}>
                      <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
                      <span class="recent-title">{post.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ) : (
          <p class="empty">新的文章正在准备中。</p>
        )}
      </section>
  
      <section class="home-sec container" aria-labelledby="go-title">
        <header class="sec-head">
          <h2 id="go-title">站点索引</h2>
        </header>
        <ul class="go-grid">
          {destinations.map((item, index) => (
            <li>
              <a class="go-card" href={item.href}>
                <span class="go-scene">
                  <img src={`/zompopo/scenes/${item.scene}.webp`} alt={item.alt} width="960" height="720" loading="lazy" decoding="async" />
                </span>
                <span class="go-label">
                  <span class="go-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <strong>{item.title}</strong>
                  <small>{item.description}</small>
                </span>
                <span class="go-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8" /></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
  
      <section class="home-sec band grain" aria-labelledby="radar-title">
        <div class="container">
          <header class="sec-head">
            <h2 id="radar-title">外面的世界</h2>
          </header>
          <div class="radar-grid">
            <div class="radar-card">
              <h3>太空观测站</h3>
              <p>从地球上的发射台，到太阳表面的活动。</p>
              <div class="radar-actions">
                <a class="btn btn-ghost" href="/space-now/">Space Now</a>
                <a class="btn btn-ghost" href="/solar-watch/">Solar Watch</a>
              </div>
            </div>
            <div class="radar-card">
              <h3>AI 圈现在</h3>
              <NewsList client:visible />
              <p class="news-attribution">数据来源：<a href="https://aihot.news" target="_blank" rel="noopener noreferrer">AI HOT</a></p>
            </div>
          </div>
        </div>
      </section>
  
      <section class="home-sec container" aria-labelledby="bobo-title">
        <div class="bobo-split">
          <div class="bobo-copy">
            <h2 id="bobo-title">关于这个站点</h2>
            <p class="lead">他在每一篇文章旁边待命，也在关于页讲潘勒斯的故事。</p>
            <a class="btn btn-primary" href="/about/">关于我</a>
          </div>
          <figure class="bobo-fig grain" aria-hidden="true">
            <img src="/zompopo/stickers/reading.webp" alt="" width="455" height="353" loading="lazy" decoding="async" />
          </figure>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import type { MaskoHandle } from '@masko/player';

  const bay = document.querySelector<HTMLElement>('[data-bay]');
  const mascot = document.querySelector<HTMLElement>('[data-mascot]');
  const host = mascot?.querySelector<HTMLElement>('[data-mascot-player]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-mascot-toggle]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const still = () => reducedMotion.matches || !!bay?.hasAttribute('data-still');
  let relaxBay = () => {};

  if (mascot && host && toggle) {
    let player: MaskoHandle | undefined;
    let paused = false;

    const showPoster = () => {
      player?.destroy();
      player = undefined;
      paused = false;
      bay?.removeAttribute('data-still');
      mascot.removeAttribute('data-clip-visible');
      toggle.hidden = true;
      toggle.textContent = '暂停动画';
    };

    const syncMotion = async () => {
      if (reducedMotion.matches) {
        showPoster();
        return;
      }
      try {
        const { mountMascot } = await import('@masko/player');
        if (reducedMotion.matches || player) return;
        player = mountMascot(host, {
          clip: { webm: '/zompopo/one-last-rep.webm', hevc: '/zompopo/one-last-rep.mov' },
          sound: false,
        });
        player.on('clip', () => {
          mascot.setAttribute('data-clip-visible', '');
          toggle.hidden = false;
        });
        player.on('error', showPoster);
      } catch {
        showPoster();
      }
    };

    toggle.addEventListener('click', () => {
      if (!player) return;
      paused = !paused;
      if (paused) player.pause();
      else player.play();
      toggle.textContent = paused ? '继续播放' : '暂停动画';
      if (paused) {
        bay?.setAttribute('data-still', '');
        relaxBay();
      } else {
        bay?.removeAttribute('data-still');
      }
    });
    reducedMotion.addEventListener('change', syncMotion);
    void syncMotion();
  }

  // Header merges with the bay until the bay has scrolled past it.
  const head = document.querySelector<HTMLElement>('.site-head');
  if (bay && head?.classList.contains('is-lab')) {
    const syncHead = () => head.classList.toggle('is-lab', bay.getBoundingClientRect().bottom > head.offsetHeight);
    window.addEventListener('scroll', syncHead, { passive: true });
    syncHead();
  }

  // Depth: pointer moves wall, floor and character by different amounts; scroll lets the character linger.
  if (bay && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const tick = () => {
      raf = 0;
      x += (tx - x) * 0.14;
      y += (ty - y) * 0.14;
      bay.style.setProperty('--px', x.toFixed(3));
      bay.style.setProperty('--py', y.toFixed(3));
      if (!still()) bay.style.setProperty('--sy', Math.min(1, window.scrollY / bay.offsetHeight).toFixed(3));
      if (Math.abs(tx - x) > 0.004 || Math.abs(ty - y) > 0.004) raf = requestAnimationFrame(tick);
    };
    const wake = () => { if (!raf) raf = requestAnimationFrame(tick); };
    const ease = () => { if (!still()) wake(); };
    relaxBay = () => { tx = 0; ty = 0; wake(); };
    bay.addEventListener('pointermove', (event) => {
      if (still()) return;
      const rect = bay.getBoundingClientRect();
      tx = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
      ty = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
      wake();
    });
    bay.addEventListener('pointerleave', relaxBay);
    window.addEventListener('scroll', ease, { passive: true });
    reducedMotion.addEventListener('change', () => {
      if (!reducedMotion.matches) return;
      cancelAnimationFrame(raf);
      raf = 0; tx = ty = x = y = 0;
      for (const name of ['--px', '--py', '--sy']) bay.style.setProperty(name, '0');
    });
  }
</script>

<style>
  /* Hallmark · shape: Workbench · genre: playful · theme: Hum base + Lab homepage (direction C, user-chosen 2026-11-24) · redesign: full
   * hero: Stage (/) · nav: squared chip rail · footer: mast + colophon · imagery: character art + scene modules
   * signature: dark character bay + technical grid + numbered modules + square controls · axes: light/grotesque/green-lime · posture: full palette
   * contrast: pass · fold: pass · v2.1.0 · hero-review: fix · 3 findings · 3 resolved (grain+torn texture, all five nav links visible in a second row ≤40rem, seal repositioned clear of companion)
   * finish-review: fix · 5 findings · 5 resolved (solar feed provenance, scientific chart font floor, solar labels, research heading hierarchy, footer spacing)
   * lab pass: C production with light/dark tokens, reserved stage label on mobile, bordered mobile index rows */
  /* Hallmark · waivers: 26b no form controls on page · 44c/79 fold heuristic measures text blocks, stage visual extends to the caption · kept: 4 writing-grid headings moved off the homepage to the full /blog/ list (links 63/63 intact) · kept figures 03:23/06:53 are live countdown reads · kept ids intro-title/live-title superseded by #writing/#radar section anchors */

  .home { background: var(--color-lab-paper); }

  /* hero: full-bleed Lab bay. Grid = Lab Stage signature (design.md). --px/--py come from the pointer, --sy from scroll. */
  .hero { --side: min(92svh, 56vw); --px: 0; --py: 0; --sy: 0; position: relative; isolation: isolate; overflow: hidden; min-height: calc(100svh - var(--head-h, 64px)); background: var(--color-lab-panel); color: var(--color-lab-ink); }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(120% 100% at 50% 42%, transparent 52%, oklch(12% 0.02 150 / 0.55) 100%); }
  .bay-wall, .bay-floor { position: absolute; z-index: 0; background-image: linear-gradient(color-mix(in oklab, var(--color-lab-accent) 8%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in oklab, var(--color-lab-accent) 8%, transparent) 1px, transparent 1px); background-size: var(--grid-lab) var(--grid-lab); }
  .bay-wall { inset: -3% -3% 42% -3%; transform: translate(calc(var(--px) * -8px), calc(var(--py) * -5px + var(--sy) * 16px)); }
  .bay-wall::after { content: ''; position: absolute; inset: auto 0 0; height: 1px; background: color-mix(in oklab, var(--color-lab-ink) 24%, transparent); }
  .bay-floor { left: -35%; right: -35%; top: 58%; height: 160%; background-color: var(--color-lab-panel-2); transform-origin: 50% 0; transform: translate(calc(var(--px) * -14px), calc(var(--sy) * 34px)) perspective(620px) rotateX(62deg); mask-image: linear-gradient(to bottom, transparent, #000 12%, #000); }
  .hero-inner { position: relative; z-index: 3; display: grid; min-height: calc(100svh - var(--head-h, 64px)); padding-block: var(--space-xl); }
  .hero-copy { align-self: center; max-width: 30rem; }
  .hero-copy h1 { margin: 0; font-family: var(--font-lab-display); font-weight: 700; font-size: clamp(3.5rem, 4.8vw, 5.3rem); line-height: 1.14; letter-spacing: -0.065em; text-wrap: balance; }
  .hero-kicker { display: block; margin-bottom: var(--space-lg); font-family: var(--font-outlier); font-size: var(--text-xs); font-weight: 500; line-height: 1.4; letter-spacing: 0.02em; color: var(--color-lab-ink-2); }
  .hero-copy strong { font-weight: 700; }
  .dot { color: var(--color-lab-accent); }
  .hero-sub { display: block; margin-top: var(--space-sm); font-family: var(--font-outlier); font-size: var(--text-md); font-weight: 500; letter-spacing: 0.02em; color: var(--color-lab-ink-2); }
  .intro { max-width: 30rem; margin: var(--space-md) 0 0; color: var(--color-lab-ink-2); line-height: 1.65; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-lg); }
  .home .btn { border-radius: var(--radius-lab-control); }
  .home .btn-primary { background: var(--color-lab-accent); border-color: transparent; color: var(--color-lab-panel); box-shadow: var(--shadow-card); }
  .home .btn-primary:hover { transform: translateY(-1px); box-shadow: var(--shadow-card), var(--shadow-lift); }
  .home .btn-primary:active { transform: translateY(2px); box-shadow: var(--shadow-card); }
  .home .btn-ghost { border-color: var(--color-ink); background: transparent; color: var(--color-ink); }
  .home .btn-ghost:hover { background: var(--color-lab-wash); color: var(--color-ink); }
  .hero .btn-ghost { border-color: var(--color-lab-line); background: transparent; color: var(--color-lab-ink); }
  .hero .btn-ghost:hover { background: var(--color-lab-panel-2); color: var(--color-lab-ink); }

  /* The clip is square: the character fills 0.147..0.948 of its height, feet at 0.052. The poster shares the same box so the swap does not jump. */
  .mascot { position: absolute; z-index: 2; left: 68%; bottom: 5.5%; margin: 0; translate: -50% 0; pointer-events: none; transform: translate(calc(var(--px) * -24px), calc(var(--py) * -12px + var(--sy) * 84px)); }
  .mascot-frame { position: relative; width: var(--side); height: var(--side); }
  .mascot-pool { position: absolute; left: 50%; bottom: -9%; width: 100%; height: 26%; translate: -50% 0; background: radial-gradient(50% 50% at 50% 50%, color-mix(in oklab, var(--color-lab-accent) 20%, transparent), transparent 70%); }
  .mascot-shadow { position: absolute; left: 50.5%; bottom: 2.2%; width: 48%; height: 6%; translate: -50% 0; background: radial-gradient(50% 50% at 50% 50%, oklch(10% 0.02 150 / 0.7), transparent 72%); }
  .mascot-img { position: absolute; left: 50%; bottom: 5.2%; height: 80%; width: auto; translate: -50% 0; }
  .mascot-player { position: absolute; inset: 0; }
  [data-clip-visible] .mascot-img { opacity: 0; }
  .bay-hud { position: absolute; z-index: 4; inset: var(--space-lg) 0 auto; display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-md); pointer-events: none; }
  .bay-hud > * { pointer-events: auto; }
  .stage-id { display: inline-flex; align-items: baseline; gap: var(--space-xs); min-height: 44px; font-family: var(--font-outlier); font-size: var(--text-xs); line-height: 1.4; color: var(--color-lab-ink-2); }
  .stage-id [lang='en'] { letter-spacing: 0.02em; text-transform: uppercase; }
  .mascot-toggle { min-height: 44px; padding: var(--space-3xs) var(--space-sm); border: 1px solid color-mix(in oklab, var(--color-lab-ink-2) 60%, transparent); border-radius: var(--radius-lab-control); background: transparent; color: var(--color-lab-ink); font-size: var(--text-xs); font-weight: 600; transition: transform var(--dur-micro) var(--ease-spring), background var(--dur-micro) var(--ease-snap); }
  .mascot-toggle:hover { background: var(--color-lab-panel-2); transform: translateY(-1px); }
  .mascot-toggle:active { transform: translateY(1px); }

  /* ---- sections: paper over the lab ---- */
  .paper { position: relative; display: flow-root; margin-top: -14px; background: var(--color-lab-paper); }
  .home-sec { margin-top: var(--section-gap); }
  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-md); margin-bottom: var(--space-xl); }
  .sec-head h2 { margin: 0; font-family: var(--font-lab-display); font-size: var(--text-section); font-weight: 700; letter-spacing: -0.04em; }
  .band { margin-top: calc(var(--section-gap) + var(--space-2xl)); background: var(--color-lab-wash-2); padding: var(--space-3xl) 0 var(--space-2xl); }

  .writing-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gap-columns); align-items: start; }
  .featured { position: relative; display: block; text-decoration: none; background: var(--color-lab-wash); border: 1px solid var(--color-edge); border-radius: var(--radius-lab); padding: var(--space-xl); box-shadow: var(--shadow-card); transition: transform var(--dur-short) var(--ease-spring), box-shadow var(--dur-short) var(--ease-snap); }
  .featured:hover { transform: translateY(-2px); box-shadow: var(--shadow-card), var(--shadow-lift); }
  .card-label { margin: 0; font-size: var(--text-xs); color: var(--color-ink-2); }
  .card-label time { font-family: var(--font-outlier); }
  .featured h3 { margin: var(--space-sm) 0 0; font-size: var(--text-display-s); letter-spacing: var(--tracking-display); text-wrap: balance; }
  .featured-desc { margin: var(--space-md) 0 0; font-size: var(--text-lead); line-height: 1.65; color: var(--color-ink-2); text-wrap: pretty; }
  .tag-row { display: flex; flex-wrap: wrap; gap: var(--space-3xs); margin: var(--space-lg) 0 0; padding: 0; list-style: none; }
  .tag-row li { padding: var(--space-3xs) var(--space-sm); border: 1px solid var(--color-edge); border-radius: var(--radius-lab-control); background: var(--color-card); font-size: var(--text-xs); color: var(--color-ink-2); }
  .recent-list { margin: 0; padding: 0; list-style: none; }
  .recent-list li + li { border-top: var(--rule-hair) solid var(--color-rule); }
  .recent-list a { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: var(--space-md); align-items: baseline; padding: var(--space-md) var(--space-3xs); text-decoration: none; }
  .recent-list time { font-family: var(--font-outlier); font-size: var(--text-xs); color: var(--color-muted); }
  .recent-title { font-weight: 600; line-height: 1.5; text-wrap: pretty; transition: transform var(--dur-micro) var(--ease-snap), color var(--dur-micro) var(--ease-snap); }
  .recent-list a:hover .recent-title { transform: translateX(4px); color: var(--color-lab-signal); }
  .empty { color: var(--color-muted); }

  .go-grid { margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: hidden; border: var(--rule-hair) solid var(--color-ink); border-radius: var(--radius-lab); background: var(--color-card); list-style: none; }
  .go-grid li + li { border-left: var(--rule-hair) solid var(--color-ink); }
  .go-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto 1fr; align-items: center; gap: 0; height: 100%; padding: 0; border: 0; color: var(--color-ink); text-decoration: none; transition: background-color var(--dur-micro) var(--ease-snap); }
  .go-card:hover { background: var(--color-lab-wash); }
  .go-scene { display: block; grid-column: 1 / -1; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 0; background: var(--color-paper-2); }
  .go-scene img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .go-label { display: grid; align-self: start; gap: var(--space-3xs); padding: var(--space-lg); }
  .go-index { font-family: var(--font-outlier); font-size: var(--text-xs); color: var(--color-lab-signal); }
  .go-card strong { font-family: var(--font-lab-display); font-size: var(--text-title); font-weight: 700; letter-spacing: var(--tracking-display); transition: color var(--dur-micro) var(--ease-snap); }
  .go-card small { display: block; font-size: var(--text-body); line-height: 1.6; color: var(--color-ink-2); text-wrap: pretty; }
  .go-arrow { display: grid; place-items: center; align-self: end; width: 2.75rem; height: 2.75rem; margin: 0 var(--space-lg) var(--space-lg) 0; border: 1px solid var(--color-ink); border-radius: var(--radius-lab-control); background: transparent; color: var(--color-ink); transition: transform var(--dur-micro) var(--ease-spring), background-color var(--dur-micro) var(--ease-snap), color var(--dur-micro) var(--ease-snap); }
  .go-arrow svg { width: 1.1rem; height: 1.1rem; }
  .go-card:hover strong { color: var(--color-lab-signal); }
  .go-card:hover .go-arrow { transform: translate(2px, -2px) rotate(45deg); background: var(--color-ink); color: var(--color-lab-on-ink); }
  .go-card:active .go-arrow { transform: translate(0, 0) rotate(45deg); }

  .band .container { position: relative; z-index: 1; }
