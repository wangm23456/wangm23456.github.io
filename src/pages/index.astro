---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsList from '../components/NewsList';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const [featured, ...recent] = posts.slice(0, 4);
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const poses = [
  { id: 'idle', label: '待机', alt: '波波站着，手里拿着紫色哑铃和绿色小玩偶' },
  { id: 'celebrate', label: '庆祝', alt: '波波笑着举起紫色哑铃' },
  { id: 'rest', label: '休息', alt: '波波坐下来休息' },
];
const destinations = [
  { number: '01', label: 'WRITING', title: '写作', description: '关于 AI、工程与科学的原创长文。', href: '/blog/', icon: 'writing' },
  { number: '02', label: 'RESEARCH', title: '研究笔记', description: '专题文章背后的文献与证据。', href: '/research/', icon: 'research' },
  { number: '03', label: 'OBSERVATORY', title: '太空观测', description: '查看下一次火箭发射与任务动态。', href: '/space-now/', icon: 'space' },
];
---

<BaseLayout title="潘勒斯的个人主页" description="潘勒斯的个人主页。和波波一起探索 AI、工程与科学，阅读原创长文、研究笔记和太空观测。" wide home>
  <div class="personal-home">
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-copy">
        <p class="eyebrow intro-label"><span></span> ARCANA / PERSONAL SITE</p>
        <h1 id="intro-title">你好，我是<br /><strong>潘勒斯<span>。</span></strong></h1>
        <p class="motto" lang="en">Engineering Is Magic.</p>
        <p class="intro-text">我在这里记录 AI、工程与科学。<br class="desktop-break" />读论文、拆系统，把好奇的问题写成文章。</p>
        <div class="intro-actions">
          <a class="primary-action" href="#writing">读最新文章 <span aria-hidden="true">↘</span></a>
          <a class="plain-action" href="/about/">关于我 <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <figure class="mascot" data-mascot>
        <div class="stage" aria-label="波波角色展示">
          <span class="stage-index eyebrow" aria-hidden="true">FIG. 01 / ARCANA IP</span>
          <div class="stage-orbit" aria-hidden="true"></div>
          <span class="stage-word" aria-hidden="true">BOBO</span>
          <span class="spark spark--left" aria-hidden="true">✦</span>
          <span class="spark spark--right" aria-hidden="true">✧</span>
          <img class="mascot-img" src="/zompopo/idle.webp" alt={poses[0].alt} width="640" height="1149" fetchpriority="high" />
          <span class="stage-seal eyebrow" aria-hidden="true">100%<br />UNDYING</span>
        </div>
        <figcaption class="mascot-caption">
          <div><strong>波波</strong><span class="eyebrow">ZOMPOPO</span></div>
          <div class="pose-controls" role="group" aria-label="切换波波的姿态" hidden>
            {poses.map((pose, index) => (
              <button type="button" data-pose={`/zompopo/${pose.id}.webp`} data-alt={pose.alt} aria-pressed={index === 0 ? 'true' : 'false'}>{pose.label}</button>
            ))}
          </div>
          <span class="sr-only" role="status" data-pose-status></span>
        </figcaption>
      </figure>
    </section>

    <nav class="directory" aria-label="探索 Arcana">
      {destinations.map((item) => (
        <a class="portal" href={item.href}>
          <span class:list={['portal-icon', `portal-icon--${item.icon}`]} aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              {item.icon === 'writing' && <path d="M5 4h10l4 4v12H5z M15 4v5h4 M8 12h8 M8 16h6" />}
              {item.icon === 'research' && <path d="M9 3h6m-5 0v7l-5 8a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-8V3M8 15h8" />}
              {item.icon === 'space' && <><circle cx="12" cy="12" r="7" /><ellipse cx="12" cy="12" rx="11" ry="3.8" transform="rotate(-35 12 12)" /></>}
            </svg>
          </span>
          <span class="portal-copy"><span class="eyebrow">{item.number} / {item.label}</span><strong>{item.title}</strong><small>{item.description}</small></span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>

    <section class="home-section" id="writing" aria-labelledby="writing-title">
      <div class="section-heading">
        <div><p class="eyebrow">01 / FIELD NOTES</p><h2 id="writing-title">最近写了什么</h2></div>
        <a class="plain-action" href="/blog/">所有文章 <span aria-hidden="true">↗</span></a>
      </div>
      {featured ? (
        <div class="writing-grid" class:list={[{ 'writing-grid--single': !recent.length }]}>
          <a class="featured" href={`/blog/${featured.id}/`}>
            <div class="featured-meta"><span class="eyebrow">LATEST / 最新文章</span><time datetime={formatDate(featured.data.date)}>{formatDate(featured.data.date)}</time></div>
            <h3>{featured.data.title}</h3>
            {featured.data.description && <p>{featured.data.description}</p>}
            <div class="featured-end"><ul aria-label="文章标签">{featured.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}</ul><span class="arrow" aria-hidden="true">↗</span></div>
          </a>
          {recent.length > 0 && <ul class="recent-list">
            {recent.map((post) => (
              <li><a href={`/blog/${post.id}/`}><div><time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time><h3>{post.data.title}</h3></div><span class="arrow" aria-hidden="true">↗</span></a></li>
            ))}
          </ul>}
        </div>
      ) : <p>新的文章正在准备中。</p>}
    </section>

    <section class="home-section" aria-labelledby="live-title">
      <div class="section-heading">
        <div><p class="eyebrow">02 / THE RADAR</p><h2 id="live-title">外面的世界</h2></div>
      </div>
      <div class="radar-grid">
        <div class="radar-card radar-links">
          <p class="eyebrow">OBSERVATORY</p><h3>太空观测站</h3>
          <p>从地球上的发射台，到太阳表面的活动。</p>
          <a href="/space-now/">Space Now <span aria-hidden="true">↗</span></a>
          <a href="/solar-watch/">Solar Watch <span aria-hidden="true">↗</span></a>
        </div>
        <div class="radar-card">
          <p class="eyebrow">AI NEWS</p><h3>AI 圈现在</h3>
          <NewsList client:visible />
          <p class="news-attribution">数据来源：<a href="https://aihot.virxact.com" target="_blank" rel="noopener noreferrer">AI HOT ↗</a></p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const mascot = document.querySelector('[data-mascot]');
  const image = mascot?.querySelector('img');
  const controls = mascot?.querySelector<HTMLElement>('.pose-controls');
  const status = mascot?.querySelector('[data-pose-status]');
  if (image && controls && status) {
    controls.hidden = false;
    let request = 0;
    controls.addEventListener('click', async (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>('button[data-pose]');
      if (!button?.dataset.pose) return;
      const current = ++request;
      if (button.getAttribute('aria-pressed') === 'true') {
        status.textContent = '';
        return;
      }
      const next = new Image();
      next.src = button.dataset.pose;
      try {
        await next.decode();
      } catch {
        if (current === request) status.textContent = '图片加载失败，请重试。';
        return;
      }
      if (current !== request) return;
      image.src = next.src;
      image.alt = button.dataset.alt ?? '';
      controls.querySelector('[aria-pressed="true"]')?.setAttribute('aria-pressed', 'false');
      button.setAttribute('aria-pressed', 'true');
      status.textContent = image.alt;
    });
  }
</script>

<style>
  .personal-home { --rule: color-mix(in srgb, var(--ink) 23%, transparent); --accent: #a3185d; --rose: #f7c4df; --rose-ink: #321529; }
  :global(html.dark) .personal-home { --accent: #ff9bc9; }
  .eyebrow, time { margin: 0; font: 700 0.69rem/1.5 var(--font-mono); letter-spacing: 0.09em; }
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .intro-label { color: var(--accent); display: flex; align-items: center; gap: 0.65rem; }
  .intro-label span { width: 0.52rem; height: 0.52rem; border-radius: 50%; background: currentColor; }
  h1 { margin: 1.45rem 0 0; font-size: clamp(2.8rem, 6vw, 5.8rem); font-weight: 850; letter-spacing: -0.085em; line-height: 1.02; }
  h1 strong { display: inline-block; margin-top: 0.18em; font-weight: 950; }
  h1 strong span { color: var(--accent); }
  .motto { margin: 1.1rem 0 0; font: italic 700 clamp(1.15rem, 2.4vw, 1.85rem)/1.3 Georgia, serif; }
  .intro-text { margin: 1.15rem 0 0; color: var(--muted); line-height: 1.8; }
  .intro-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.65rem; }
  .primary-action, .plain-action { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ink); font-weight: 800; font-size: 0.85rem; text-decoration: none; }
  .primary-action { background: var(--ink); color: var(--paper); padding: 0.68rem 1rem; border-radius: 0.25rem; }
  .primary-action:hover { background: var(--accent); }
  :global(html.dark) .primary-action:hover { color: #22121d; }
  .plain-action { padding-block: 0.45rem; text-decoration: underline; text-underline-offset: 0.28em; }
  .plain-action:hover { color: var(--accent); }
  .mascot { min-width: 0; margin: 0; border: 1px solid var(--rule); border-radius: 0.5rem; overflow: hidden; background: var(--card); }
  .stage { position: relative; isolation: isolate; display: grid; place-items: center; height: clamp(21rem, 39vw, 32rem); overflow: hidden; background: radial-gradient(ellipse at 49% 40%, #fff2f8 0%, var(--rose) 67%, #e9a3ca 100%); color: var(--rose-ink); }
  .stage::before { content: ''; position: absolute; inset: 0; background: radial-gradient(#713453 0.7px, transparent 0.7px); background-size: 8px 8px; opacity: 0.2; z-index: -1; }
  .stage::after { content: ''; position: absolute; width: 44%; height: 8%; bottom: 9%; border-radius: 50%; background: #874466; opacity: 0.18; filter: blur(10px); z-index: -1; }
  .stage-index { position: absolute; top: 1rem; left: 1rem; }
  .stage-word { position: absolute; top: 50%; left: 49%; transform: translate(-50%, -50%); z-index: -1; white-space: nowrap; font: 950 clamp(5.2rem, 13vw, 11rem)/1 var(--font-serif); letter-spacing: -0.09em; color: #fff1f8; }
  .stage-orbit { position: absolute; width: 91%; height: 44%; border: 1px solid #9a547e80; border-radius: 50%; transform: rotate(-20deg); z-index: -1; }
  .mascot-img { position: absolute; top: 8.5%; left: 14%; display: block; width: 72%; height: 83%; object-fit: contain; filter: drop-shadow(0 0.8rem 0.8rem #541b4233); }
  .spark { position: absolute; font-size: clamp(1.7rem, 4vw, 3.25rem); line-height: 1; }
  .spark--left { left: 12%; top: 30%; }
  .spark--right { right: 11%; bottom: 29%; }
  .stage-seal { position: absolute; right: 1rem; bottom: 1rem; display: grid; place-content: center; width: 4.1rem; aspect-ratio: 1; border: 1px solid; border-radius: 50%; text-align: center; transform: rotate(10deg); font-size: 0.57rem; }
  .mascot-caption { border-top: 1px solid var(--rule); padding: 0.65rem 0.9rem; min-height: 3.55rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem 0.75rem; }
  .mascot-caption > div:first-child { display: flex; align-items: baseline; gap: 0.55rem; }
  .mascot-caption .eyebrow { color: var(--muted); }
  .pose-controls:not([hidden]) { display: flex; gap: 0.25rem; }
  .pose-controls button { min-height: 2.1rem; padding: 0.2rem 0.55rem; border: 1px solid var(--rule); border-radius: 2rem; background: transparent; color: var(--ink); font: 700 0.72rem var(--font-serif); cursor: pointer; }
  .pose-controls button:hover { border-color: var(--accent); }
  .pose-controls button[aria-pressed='true'] { background: var(--rose); color: var(--rose-ink); border-color: transparent; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .directory { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; margin-top: clamp(1.5rem, 4vw, 2.5rem); }
  .portal { min-width: 0; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; gap: 0.75rem; padding: 1rem 0.9rem; border: 1px solid var(--rule); border-radius: 0.4rem; background: var(--card); color: var(--ink); text-decoration: none; }
  .portal:hover, .featured:hover { border-color: var(--accent); }
  .portal-icon { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 0.3rem; background: var(--rose); color: var(--rose-ink); }
  .portal-icon svg { width: 1.25rem; height: 1.25rem; }
  .portal-icon--research { background: #dcd2fa; color: #2e2355; }
  .portal-icon--space { background: #d8e9b6; color: #2c401e; }
  .portal-copy > * { display: block; }
  .portal-copy .eyebrow { color: var(--muted); }
  .portal-copy strong { font-size: 1.15rem; margin-top: 0.15rem; line-height: 1.25; }
  .portal-copy small { color: var(--muted); line-height: 1.5; margin-top: 0.35rem; }
  .arrow { font: 700 1.15rem/1.2 var(--font-mono); }
  .home-section { margin-top: clamp(2.7rem, 6vw, 5rem); scroll-margin-top: 1rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 0.5rem 1rem; padding-bottom: 0.85rem; margin-bottom: 1rem; border-bottom: 1px solid var(--rule); }
  .section-heading .eyebrow { color: var(--accent); }
  .section-heading h2 { margin: 0.25rem 0 0; font-size: clamp(1.55rem, 4vw, 2.65rem); letter-spacing: -0.065em; line-height: 1.12; }
  .section-heading .plain-action { white-space: nowrap; }
  .writing-grid, .radar-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 1rem; }
  .writing-grid--single { grid-template-columns: 1fr; }
  .featured, .radar-card { border-radius: 0.4rem; border: 1px solid var(--rule); padding: clamp(1rem, 3vw, 1.6rem); }
  .featured { display: flex; flex-direction: column; background: var(--rose); color: var(--rose-ink); text-decoration: none; }
  .featured-meta, .featured-end { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
  .featured h3 { font-size: clamp(1.4rem, 3vw, 2.1rem); line-height: 1.25; margin: 1rem 0 0; text-wrap: pretty; }
  .featured p { margin: 0.55rem 0 1.25rem; font-size: 0.9rem; }
  .featured-end { margin-top: auto; padding-top: 0.65rem; }
  .featured-end ul, .recent-list { list-style: none; margin: 0; padding: 0; }
  .featured-end ul { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .featured-end li { border: 1px solid #9a547e80; padding: 0.08rem 0.5rem; border-radius: 2rem; font: 700 0.68rem/1.5 var(--font-mono); }
  .recent-list a { display: flex; align-items: center; justify-content: space-between; gap: 0.7rem; min-height: 4.4rem; padding: 0.7rem 0.25rem; border-bottom: 1px solid var(--rule); color: var(--ink); text-decoration: none; }
  .recent-list a:hover { color: var(--accent); }
  .recent-list time { color: var(--muted); }
  .recent-list h3 { margin: 0.2rem 0 0; font-size: 0.98rem; line-height: 1.45; }
  .radar-card { background: var(--card); min-width: 0; }
  .radar-card .eyebrow { color: var(--accent); }
  .radar-card h3 { margin: 0.25rem 0 0.75rem; font-size: 1.35rem; }
  .radar-links { background: color-mix(in srgb, var(--card) 89%, #a6b97a); }
  .radar-links > a { display: flex; justify-content: space-between; padding: 0.55rem 0; border-bottom: 1px solid var(--rule); color: var(--ink); font-weight: 750; text-decoration: none; }
  .radar-links > a:hover { color: var(--accent); }
  .personal-home :is(a, button):focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 860px) {
    .intro { gap: 1.5rem; }
    .portal { gap: 0.45rem; padding: 0.75rem 0.6rem; }
    .portal-icon { width: 2rem; height: 2rem; }
  }
  @media (max-width: 660px) {
    .intro, .directory, .writing-grid, .radar-grid { grid-template-columns: minmax(0, 1fr); }
    .intro { gap: 1.65rem; }
    .intro-copy { padding-top: 0.3rem; }
    .intro-text { margin-top: 0.85rem; }
    .desktop-break { display: none; }
    .stage { height: clamp(18rem, 86vw, 27rem); }
    .stage-word { font-size: clamp(5rem, 23vw, 8.5rem); }
    .directory { gap: 0.55rem; }
    .portal { gap: 0.75rem; padding: 0.75rem; }
  }
</style>
