---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于我" description="关于潘勒斯、Arcana，以及站点角色波波（ZOMPOPO）。">
  <article class="about">
    <div class="about-split container">
      <div class="about-copy">
        <h1>关于潘勒斯</h1>
        <p class="motto" lang="en"><em>Engineering Is Magic.</em></p>
        <p class="intro">Arcana 是我的个人站。我在这里记录读过的论文、拆解过的系统，以及研究过程中遇到的有意思的问题。</p>
        <section class="contents">
          <h2>这里有什么</h2>
          <ul>
            <li><a href="/blog/">写作</a>：AI 模型、架构、开源工具和科学专题。</li>
            <li><a href="/research/">研究笔记</a>：长文背后的文献、证据和专题笔记。</li>
            <li><a href="/space-now/">太空观测</a>：追踪火箭发射与任务动态，也可以去 <a href="/solar-watch/">Solar Watch</a> 看太阳活动。</li>
          </ul>
        </section>
        <p class="subscribe">订阅 <a href="/rss.xml">RSS</a>，获取原创文章更新。</p>
      </div>
      <section class="mascot-note">
        <div class="mascot-art grain">
          <img src="/zompopo/stickers/coding.webp" width="457" height="346" loading="eager" fetchpriority="high" alt="波波脖子上挂着耳机，坐在笔记本电脑前，绿玩偶趴在电脑旁" />
        </div>
        <div class="mascot-copy">
          <h2>认识波波</h2>
          <p>波波（ZOMPOPO）是 Arcana 的站点角色。回到<a href="/">首页</a>，可以看到波波举哑铃，手里的绿玩偶还会打哈欠。</p>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  /* Hallmark · shape: Workbench · genre: playful · theme: Hum (deal 2/3, seed zompopo-7e95·8fca6596·2026-11-24·r0) · redesign: full
   * hero: Split (/about) · signature: torn-paper seam + card-stock · copy: verbatim */
  /* Hallmark · waivers: 26b no form controls on page; 44c, 79 split article is not a separate hero; 77 the split columns and short page preserve the existing content. */
  .about-split { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gap-columns); align-items: start; padding-top: var(--space-3xl); padding-bottom: var(--section-gap); }
  .about-copy { min-width: 0; max-width: 48rem; }
  .about h1, .about h2 { text-wrap: balance; }
  .about p, .about li { text-wrap: pretty; }
  .motto { margin-top: var(--space-md); color: var(--color-ink-2); font-size: var(--text-lead); }
  .intro { margin-top: var(--space-lg); max-width: 38ch; color: var(--color-ink-2); font-size: var(--text-lead); line-height: 1.75; }
  .contents { margin-top: var(--space-2xl); }
  .contents h2 { font-size: var(--text-section); }
  .contents ul { list-style: none; margin: var(--space-lg) 0 0; padding: 0; border-top: 1px solid var(--color-rule); }
  .contents li { padding: var(--space-md) 0; border-bottom: 1px solid var(--color-rule); color: var(--color-ink-2); line-height: 1.75; }
  .about a { color: var(--color-ink); text-decoration-thickness: 2px; text-decoration-color: var(--color-accent-deep); text-underline-offset: 0.2em; }
  .about a:active { color: var(--color-accent-2); }
  .subscribe { margin-top: var(--space-xl); color: var(--color-ink-2); }
  .mascot-note { min-width: 0; overflow: hidden; background: var(--color-card); border: 1px solid var(--color-edge); border-radius: var(--radius-card); box-shadow: var(--shadow-card); }
  .mascot-art { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 3; padding: var(--space-xl); overflow: hidden; background: var(--color-paper-2); }
  .mascot-art img { width: min(86%, 22rem); height: auto; }
  .mascot-copy { padding: var(--space-xl); }
  .mascot-copy h2 { font-size: var(--text-2xl); }
  .mascot-copy p { margin-top: var(--space-md); color: var(--color-ink-2); line-height: 1.75; }
  .about :is(a, button):focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .about *, .about *::before, .about *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
  }
  @media (max-width: 60rem) {
    .about-split { grid-template-columns: minmax(0, 1fr); padding-top: var(--space-xl); }
    .mascot-note { max-width: 36rem; }
  }
  @media (max-width: 40rem) {
    .contents { margin-top: var(--space-xl); }
    .mascot-copy { padding: var(--space-lg); }
  }
</style>
